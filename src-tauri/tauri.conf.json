{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mqx",
  "version": "0.2.0",
  "identifier": "dev.mqx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "mqx",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMjkxQjgzQTlFRTNBNjIKUldSaU91NnBneHNwUDRWanBuaFU2SXJRUnRjL1ArUkV1TnVYMkc1YitHMHBZaDZUMGpjWStXUTcK",
      "endpoints": [
        "https://github.com/hauke-gathmann/mqx/releases/latest/download/latest.json"
      ]
    }
  }
}
