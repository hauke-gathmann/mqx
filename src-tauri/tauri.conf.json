{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mqx",
  "version": "0.2.0",
  "identifier": "dev.mqx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "mqx",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "category": "DeveloperTool",
    "shortDescription": "Explore MQTT topics, inspect payloads, and record broker traffic.",
    "publisher": "mqx contributors",
    "homepage": "https://github.com/hauke-gathmann/mqx",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQTUyRTUyMkM1ODcxNDgKUldSSWNWZ3NVaTZsN1FIZGE0eWsyRUlpL1FBdGlKbFp4c1hTaXRwcndDUHpuTW1iS3NwM3Q1QmgK",
      "endpoints": [
        "https://github.com/hauke-gathmann/mqx/releases/latest/download/latest.json"
      ]
    }
  }
}
